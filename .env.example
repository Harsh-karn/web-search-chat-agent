# Google Gemini API Key (required for gemini-2.5-flash agent)
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (required for time-filtered web_search tool)
# Get yours at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: SQLite Database path (defaults to ./data/chat.db)
DATABASE_PATH=./data/chat.db

# Optional: Default Timezone fallback if client does not provide one
DEFAULT_TIMEZONE=UTC


# Required in production: random stable secret, at least 32 characters. Never commit its value.
SESSION_SECRET=
# Optional model override (actual default)
GEMINI_MODEL=gemini-2.5-flash
# Optional search endpoint override for isolated integration tests
TAVILY_BASE_URL=https://api.tavily.com/search
